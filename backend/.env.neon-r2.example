APP_NAME=BlogSystem
APP_ENV=production
API_PREFIX=/api

# Copy the pooled PostgreSQL connection string from Neon (hostname contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
PHOTO_STORAGE=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=blogsystem-photos

# Optional: an HTTPS custom domain connected to the bucket for public images.
# Leave empty to use a private bucket with temporary signed download URLs.
R2_PUBLIC_BASE_URL=

# Only needed when accessing the backend directly from a different browser origin.
CORS_ORIGINS=http://localhost:3000
